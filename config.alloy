// Definiere das Ziel: unser Loki-Container
loki.write "local_loki" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}

// Definiere, WIE Container gefunden werden sollen.
discovery.docker "all_containers" {
	host = "unix:///var/run/docker.sock"
}

// Definiere die Quelle (Log-Sammlung) und verbinde sie mit der Discovery.
loki.source.docker "all_containers" {
    // HINZUGEFÜGT: Diese Zeile wurde basierend auf dem Fehler ergänzt.
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.docker.all_containers.targets
	forward_to = [loki.write.default.receiver]
}
