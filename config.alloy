// ###############################
// #### Telemetry Configuration ####
// ###############################

// Aktiviert die Live-Debugging-Benutzeroberfläche von Alloy.
// Diese ist über http://localhost:12345 erreichbar und hilft bei der Analyse der Pipeline.
livedebugging {
  enabled = true
}


// #### Traces & Logs Pipeline ####

// 1. Empfängt Traces und Logs von der Python-App im OTLP-Format.
// Hier kann ich mir im Live Debugger die rohen Logs und Traces anschauen. Logs haben nun auch Metadaten zB Trace ID
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  // Leitet die Daten an die entsprechenden Exporter weiter.
  output {
    traces = [otelcol.exporter.otlp.to_tempo.input]
    logs   = [otelcol.exporter.loki.to_loki.input]
  }
}

// 2. Definiert den Exporter, um Traces an Tempo zu senden.
otelcol.exporter.otlp "to_tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// 3. Definiert den Exporter, um die OTLP-Logs an Loki zu senden.
otelcol.exporter.loki "to_loki" {
  forward_to = [loki.write.local.receiver]
}

// 4. Definiert den finalen Schreib-Endpunkt für Loki.
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
