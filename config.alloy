// ###############################
// #### Logging Configuration ####
// ###############################

// Aktiviert die Live-Debugging-Benutzeroberfläche von Alloy.
// Diese ist über http://localhost:12345 erreichbar und hilft bei der Analyse der Pipeline.
livedebugging {
  enabled = true
}


// #### Traces, Logs & Metrics Pipeline ####

// 1. Empfängt Traces, Logs und Metriken von der Python-App im OTLP-Format.
// Hier kann ich mir im Live Debugger die rohen Logs, Traces und custom Metriken anschauen.
// Logs haben nun auch Metadaten zB Trace ID
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  // Leitet die Daten an die entsprechenden Exporter weiter.
  output {
    traces = [otelcol.exporter.otlp.to_tempo.input]
    logs   = [otelcol.exporter.loki.to_loki.input]
    metrics = [otelcol.exporter.prometheus.to_prometheus_exporter.input]
  }
}

// 2. Definiert den Exporter, um Traces an Tempo zu senden.
otelcol.exporter.otlp "to_tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// 3. Definiert den Exporter, um die OTLP-Logs an Loki zu senden.
otelcol.exporter.loki "to_loki" {
  forward_to = [loki.write.local.receiver]
}

// 4. Definiert den finalen Schreib-Endpunkt für Loki.
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// 5. Definiert den OTel-Prometheus-Exporter als Vermittler.
// Er nimmt die Metriken vom OTLP-Receiver entgegen...
otelcol.exporter.prometheus "to_prometheus_exporter" {
  // ... und leitet sie an die Prometheus remote_write-Komponente weiter.
  forward_to = [prometheus.remote_write.to_prometheus.receiver]
}

// 6. Definiert den Exporter, um Metriken an den Prometheus-Server zu senden.
// Diese Komponente bleibt unverändert.
prometheus.remote_write "to_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
